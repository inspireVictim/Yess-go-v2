<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:YessGoFront.Views.Controls"
             x:Class="YessGoFront.Views.DeliveryTermsPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F4F6F8">
    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Верхняя панель -->
        <Grid Padding="16,44,16,8" BackgroundColor="#0F6B53">
            <Grid ColumnDefinitions="Auto,*,Auto" VerticalOptions="Center">
                <Border WidthRequest="36" HeightRequest="36"
                        StrokeThickness="0"
                        BackgroundColor="#FFFFFF"
                        StrokeShape="RoundRectangle 18">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped" />
                    </Border.GestureRecognizers>
                    <Image Source="back_partner.svg" 
                        Aspect="AspectFit" 
                        Margin="8" />
                </Border>

                <Label Grid.Column="1"
                    Text="Условия доставки"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    TextColor="White"
                    FontAttributes="Bold"
                    FontSize="18"/>
            </Grid>
        </Grid>
        
        <!-- Контент -->
        <ScrollView Grid.Row="1" Padding="16">
            <Label FontSize="14" TextColor="#6B7280" LineBreakMode="WordWrap">
                <Label.FormattedText>
                    <FormattedString>

                        <!-- Заголовок -->
                        <Span Text="УСЛОВИЯ ДОСТАВКИ" FontAttributes="Bold" FontSize="20"/>
                        <Span Text="&#10;Приложения YESS!GO" FontSize="16"/>
                        <Span Text="&#10;&#10;" />

                        <!-- 1. Общие положения -->
                        <Span Text="1. ОБЩИЕ ПОЛОЖЕНИЯ" FontAttributes="Bold"/>
                        <Span Text="&#10;--------------------------------------&#10;" />

                        <Span Text="1.1. Настоящие Условия доставки определяют порядок доставки товаров и предоставления услуг, заказанных через мобильное приложение YESS!GO (далее — «Приложение»)." />
                        <Span Text="&#10;&#10;" />

                        <Span Text="1.2. Доставка товаров и предоставление услуг осуществляются партнёрами Приложения в соответствии с их собственными условиями." />
                        <Span Text="&#10;&#10;" />

                        <!-- 2. Способы доставки -->
                        <Span Text="2. СПОСОБЫ ДОСТАВКИ" FontAttributes="Bold"/>
                        <Span Text="&#10;--------------------------------------&#10;" />

                        <Span Text="2.1. Доставка товаров может осуществляться следующими способами:" />
                        <Span Text="&#10;• Самовывоз из пункта выдачи партнёра" />
                        <Span Text="&#10;• Курьерская доставка по адресу Пользователя" />
                        <Span Text="&#10;• Доставка через службы доставки партнёров" />
                        <Span Text="&#10;&#10;" />

                        <Span Text="2.2. Способы доставки и их доступность указываются в описании каждого товара или услуги." />
                        <Span Text="&#10;&#10;" />

                        <!-- 3. Сроки доставки -->
                        <Span Text="3. СРОКИ ДОСТАВКИ" FontAttributes="Bold"/>
                        <Span Text="&#10;--------------------------------------&#10;" />

                        <Span Text="3.1. Сроки доставки указываются в описании товара или услуги и зависят от:" />
                        <Span Text="&#10;• Местоположения Пользователя" />
                        <Span Text="&#10;• Выбранного способа доставки" />
                        <Span Text="&#10;• Наличия товара на складе партнёра" />
                        <Span Text="&#10;&#10;" />

                        <Span Text="3.2. Стандартные сроки доставки:" />
                        <Span Text="&#10;• Бишкек: 1–3 рабочих дня" />
                        <Span Text="&#10;• Другие города КР: 3–7 рабочих дней" />
                        <Span Text="&#10;• Отдалённые регионы: до 14 рабочих дней" />
                        <Span Text="&#10;&#10;" />

                        <Span Text="3.3. Сроки могут быть увеличены при форс-мажорных обстоятельствах." />
                        <Span Text="&#10;&#10;" />

                        <!-- 4. Регионы доставки -->
                        <Span Text="4. РЕГИОНЫ ДОСТАВКИ" FontAttributes="Bold"/>
                        <Span Text="&#10;--------------------------------------&#10;" />

                        <Span Text="4.1. Доставка осуществляется на территории Кыргызской Республики." />
                        <Span Text="&#10;&#10;" />

                        <Span Text="4.2. Доставка в другие страны не осуществляется, если иное не указано." />
                        <Span Text="&#10;&#10;" />

                        <Span Text="4.3. Доступность доставки указывается при оформлении заказа." />
                        <Span Text="&#10;&#10;" />

                        <!-- 5. Стоимость доставки -->
                        <Span Text="5. СТОИМОСТЬ ДОСТАВКИ" FontAttributes="Bold"/>
                        <Span Text="&#10;--------------------------------------&#10;" />

                        <Span Text="5.1. Стоимость доставки зависит от:" />
                        <Span Text="&#10;• Способа доставки" />
                        <Span Text="&#10;• Веса и габаритов товара" />
                        <Span Text="&#10;• Расстояния доставки" />
                        <Span Text="&#10;&#10;" />

                        <Span Text="5.2. Партнёры могут предлагать бесплатную доставку при заказе от определённой суммы." />
                        <Span Text="&#10;&#10;" />

                        <Span Text="5.3. Стоимость доставки включается в общую сумму заказа." />
                        <Span Text="&#10;&#10;" />

                        <!-- 6. Порядок доставки -->
                        <Span Text="6. ПОРЯДОК ДОСТАВКИ" FontAttributes="Bold"/>
                        <Span Text="&#10;--------------------------------------&#10;" />

                        <Span Text="6.1. После оформления заказа Пользователь получает уведомление с информацией о заказе и сроках доставки." />
                        <Span Text="&#10;&#10;" />

                        <Span Text="6.2. При курьерской доставке курьер связывается с Пользователем для уточнения времени доставки." />
                        <Span Text="&#10;&#10;" />

                        <Span Text="6.3. При получении товара Пользователь обязан проверить его целостность и соответствие заказу." />
                        <Span Text="&#10;&#10;" />

                        <Span Text="6.4. В случае дефектов или несоответствия Пользователь имеет право отказаться от товара." />
                        <Span Text="&#10;&#10;" />

                        <!-- 7. Ответственность -->
                        <Span Text="7. ОТВЕТСТВЕННОСТЬ ЗА ДОСТАВКУ" FontAttributes="Bold"/>
                        <Span Text="&#10;--------------------------------------&#10;" />

                        <Span Text="7.1. Ответственность за доставку несёт партнёр, у которого был оформлен заказ." />
                        <Span Text="&#10;&#10;" />

                        <Span Text="7.2. YESS!GO является посредником и не несёт ответственности за качество доставки." />
                        <Span Text="&#10;&#10;" />

                        <Span Text="7.3. В случае проблем Пользователь может обратиться в службу поддержки." />
                        <Span Text="&#10;&#10;" />

                        <!-- 8. Контакты -->
                        <Span Text="8. КОНТАКТНАЯ ИНФОРМАЦИЯ" FontAttributes="Bold"/>
                        <Span Text="&#10;--------------------------------------&#10;" />

                        <Span Text="📧 Email: support@yessgo.kg" />
                        <Span Text="&#10;📞 Телефон: +996 (990) 500 757" />
                        <Span Text="&#10;⏰ Время работы: Пн–Пт, 9:00–18:00" />

                    </FormattedString>
                </Label.FormattedText>
            </Label>
        </ScrollView>


        <!-- Нижний навбар -->
        <controls:BottomNavBar x:Name="BottomBar" Grid.Row="2" />
    </Grid>
</ContentPage>

