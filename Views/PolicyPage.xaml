<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:YessGoFront.Views.Controls"
             x:Class="YessGoFront.Views.PolicyPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F4F6F8">
    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Верхняя панель -->
        <Grid Padding="16,44,16,8" BackgroundColor="#0F6B53">
            <Grid ColumnDefinitions="Auto,*,Auto" VerticalOptions="Center">
                <Border WidthRequest="36" HeightRequest="36"
                    StrokeThickness="0"
                    BackgroundColor="#FFFFFF"
                    StrokeShape="RoundRectangle8">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped" />
                    </Border.GestureRecognizers>
                    <Image Source="back_arrow_icon.png" 
                        Aspect="AspectFit" 
                        Margin="8" />
                </Border>

                <Label Grid.Column="1"
                    Text="Политика конфиденциальности"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    TextColor="White"
                    FontAttributes="Bold"
                    FontSize="18"/>
            </Grid>
        </Grid>
        
        <!-- Контент -->
        <ScrollView Grid.Row="1" Padding="16">
            <VerticalStackLayout Spacing="12">

                <!-- Заголовок -->
                <Label Text="ПОЛИТИКА КОНФИДЕНЦИАЛЬНОСТИ"
               FontSize="20"
               FontAttributes="Bold"
               TextColor="#0F6B53"
               HorizontalOptions="Center"/>

                <Label Text="Приложения YESS!GO"
               FontSize="16"
               TextColor="#6B7280"
               HorizontalOptions="Center"/>

                <Label Text="Последнее обновление: 26.11.2025"
               FontSize="12"
               TextColor="#999999"
               HorizontalOptions="Center"/>

                <!-- Основной текст -->
                <Label FontSize="14" TextColor="#6B7280">
                    <Label.FormattedText>
                        <FormattedString>

                            <!-- Введение -->
                            <Span Text="Настоящая Политика конфиденциальности описывает, как приложение YESS!GO (далее — «Мы», «Нам», «Приложение») собирает, использует, хранит и защищает информацию пользователей." />
                            <Span Text="&#10;&#10;Используя приложение YESS!GO, вы подтверждаете согласие с условиями данной Политики." />
                            <Span Text="&#10;&#10;" />

                            <!-- 1 -->
                            <Span Text="1. Какие данные мы собираем" FontAttributes="Bold"/>
                            <Span Text="&#10;--------------------------------------&#10;" />

                            <Span Text="1.1. Персональные данные:" FontAttributes="Bold"/>
                            <Span Text="&#10;• Имя и фамилия" />
                            <Span Text="&#10;• Номер телефона" />
                            <Span Text="&#10;• Email" />
                            <Span Text="&#10;• Данные профиля" />
                            <Span Text="&#10;• Информация, указанная при регистрации и использовании приложения" />
                            <Span Text="&#10;&#10;" />

                            <Span Text="1.2. Технические данные:" FontAttributes="Bold"/>
                            <Span Text="&#10;• IP-адрес" />
                            <Span Text="&#10;• Тип устройства и ОС" />
                            <Span Text="&#10;• Идентификаторы устройства" />
                            <Span Text="&#10;• Логи работы приложения" />
                            <Span Text="&#10;• Cookie и аналогичные технологии" />
                            <Span Text="&#10;&#10;" />

                            <Span Text="1.3. Данные об использовании:" FontAttributes="Bold"/>
                            <Span Text="&#10;• История заказов" />
                            <Span Text="&#10;• История транзакций" />
                            <Span Text="&#10;• Действия в приложении" />
                            <Span Text="&#10;• Местоположение (при разрешении пользователя)" />
                            <Span Text="&#10;&#10;" />

                            <!-- 2 -->
                            <Span Text="2. Для чего мы используем данные" FontAttributes="Bold"/>
                            <Span Text="&#10;--------------------------------------" />
                            <Span Text="&#10;• Авторизация и регистрация" />
                            <Span Text="&#10;• Предоставление функционала приложения" />
                            <Span Text="&#10;• Обработка запросов" />
                            <Span Text="&#10;• Поддержка пользователей" />
                            <Span Text="&#10;• Улучшение сервиса" />
                            <Span Text="&#10;• Отправка уведомлений" />
                            <Span Text="&#10;• Аналитика (анонимизированные данные)" />
                            <Span Text="&#10;• Защита от мошенничества" />
                            <Span Text="&#10;&#10;" />

                            <!-- 3 -->
                            <Span Text="3. Передача данных третьим лицам" FontAttributes="Bold"/>
                            <Span Text="&#10;--------------------------------------" />
                            <Span Text="&#10;Мы не продаём персональные данные." />
                            <Span Text="&#10;&#10;Передача может осуществляться:" />
                            <Span Text="&#10;• Платёжным сервисам" />
                            <Span Text="&#10;• Провайдерам хостинга" />
                            <Span Text="&#10;• Госорганам по законному запросу" />
                            <Span Text="&#10;&#10;" />

                            <!-- 4 -->
                            <Span Text="4. Хранение и защита данных" FontAttributes="Bold"/>
                            <Span Text="&#10;--------------------------------------" />
                            <Span Text="&#10;Мы используем:" />
                            <Span Text="&#10;• Шифрование" />
                            <Span Text="&#10;• Ограничение доступа" />
                            <Span Text="&#10;• Защищённые серверы" />
                            <Span Text="&#10;• Регулярные проверки безопасности" />
                            <Span Text="&#10;&#10;" />

                            <!-- 5 -->
                            <Span Text="5. Срок хранения данных" FontAttributes="Bold"/>
                            <Span Text="&#10;--------------------------------------" />
                            <Span Text="&#10;Данные хранятся:" />
                            <Span Text="&#10;• Пока действует аккаунт" />
                            <Span Text="&#10;• Пока данные нужны для работы сервиса" />
                            <Span Text="&#10;• Пока это требуется законом" />
                            <Span Text="&#10;&#10;Вы можете запросить удаление данных." />
                            <Span Text="&#10;&#10;" />

                            <!-- 6 -->
                            <Span Text="6. Права пользователей" FontAttributes="Bold"/>
                            <Span Text="&#10;--------------------------------------" />
                            <Span Text="&#10;Вы можете:" />
                            <Span Text="&#10;• Получить доступ к данным" />
                            <Span Text="&#10;• Исправить данные" />
                            <Span Text="&#10;• Ограничить обработку" />
                            <Span Text="&#10;• Отозвать согласие" />
                            <Span Text="&#10;• Запросить удаление" />
                            <Span Text="&#10;• Отключить cookie" />
                            <Span Text="&#10;&#10;Связь: 📧 [ваша почта поддержки]" />
                            <Span Text="&#10;&#10;" />

                            <!-- 7 -->
                            <Span Text="7. Cookies" FontAttributes="Bold"/>
                            <Span Text="&#10;--------------------------------------" />
                            <Span Text="&#10;Используются для:" />
                            <Span Text="&#10;• Авторизации" />
                            <Span Text="&#10;• Улучшения интерфейса" />
                            <Span Text="&#10;&#10;" />

                            <!-- 8 -->
                            <Span Text="8. Дети" FontAttributes="Bold"/>
                            <Span Text="&#10;--------------------------------------" />
                            <Span Text="&#10;Сервис не предназначен для пользователей младше 16 лет." />
                            <Span Text="&#10;Мы не собираем данные детей намеренно." />
                            <Span Text="&#10;&#10;" />

                            <!-- 9 -->
                            <Span Text="9. Обновления политики" FontAttributes="Bold"/>
                            <Span Text="&#10;--------------------------------------" />
                            <Span Text="&#10;Политика может обновляться." />
                            <Span Text="&#10;О изменениях уведомим через приложение, сайт или email." />
                            <Span Text="&#10;&#10;" />

                            <!-- 10 -->
                            <Span Text="10. Контакты" FontAttributes="Bold"/>
                            <Span Text="&#10;--------------------------------------" />
                            <Span Text="&#10;Если у вас есть вопросы:" />
                            <Span Text="&#10;📧 support@yessgo.kg" />
                            <Span Text="&#10;🌐 www.yessgo.kg" />

                        </FormattedString>
                    </Label.FormattedText>
                </Label>

            </VerticalStackLayout>
        </ScrollView>



        <!-- Нижний навбар -->
        <controls:BottomNavBar x:Name="BottomBar" Grid.Row="2" />
    </Grid>
</ContentPage>
