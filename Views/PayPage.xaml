<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="YessGoFront.Views.PayPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F9F9F9">

    <Grid RowDefinitions="Auto,*">
        <!-- Заголовок -->
        <Border Grid.Row="0"
                BackgroundColor="#0B4A3B"
                StrokeThickness="0"
                Padding="16,12">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Кнопка назад -->
                <ImageButton Grid.Column="0"
                             x:Name="BackButton"
                             Source="back_partner.svg"
                             WidthRequest="30"
                             HeightRequest="30"
                             BackgroundColor="Transparent"
                             Aspect="AspectFit"
                             Clicked="OnBackButtonClicked"/>
                
                <!-- Заголовок -->
                <Label Grid.Column="1"
                       Text="Оплата Yess!Coin-ами"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="White"
                       VerticalOptions="Center"
                       HorizontalOptions="Center"/>
                
                <!-- Пустое место справа для балансировки -->
                <BoxView Grid.Column="2" 
                         WidthRequest="30"
                         Color="Transparent"/>
            </Grid>
        </Border>

        <!-- Контент -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="20" Padding="16">
                <!-- Кнопка: Оплата по QR code -->
                <Frame BackgroundColor="White"
                       CornerRadius="16"
                       HasShadow="True"
                       Padding="20">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnQrPaymentClicked"/>
                    </Frame.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                        <!-- Иконка QR -->
                        <Border Grid.Column="0"
                                WidthRequest="60"
                                HeightRequest="60"
                                BackgroundColor="#EEF2F7"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 12">
                            <Label Text="📱"
                                   FontSize="32"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Border>
                        
                        <!-- Текст -->
                        <VerticalStackLayout Grid.Column="1"
                                            Spacing="4"
                                            VerticalOptions="Center">
                            <Label Text="Оплата по QR code"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="#0B4A3B"/>
                            <Label Text="Отсканируйте QR код партнера"
                                   FontSize="14"
                                   TextColor="#666"/>
                        </VerticalStackLayout>
                    </Grid>
                </Frame>

                <!-- Кнопка: Поиск по названию партнера -->
                <Frame BackgroundColor="White"
                       CornerRadius="16"
                       HasShadow="True"
                       Padding="20">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSearchPartnerClicked"/>
                    </Frame.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                        <!-- Иконка поиска -->
                        <Border Grid.Column="0"
                                WidthRequest="60"
                                HeightRequest="60"
                                BackgroundColor="#EEF2F7"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 12">
                            <Label Text="🔍"
                                   FontSize="32"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Border>
                        
                        <!-- Текст -->
                        <VerticalStackLayout Grid.Column="1"
                                            Spacing="4"
                                            VerticalOptions="Center">
                            <Label Text="Поиск по названию партнера"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="#0B4A3B"/>
                            <Label Text="Найдите партнера по названию"
                                   FontSize="14"
                                   TextColor="#666"/>
                        </VerticalStackLayout>
                    </Grid>
                </Frame>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
