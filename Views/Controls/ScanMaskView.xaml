<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:skia="clr-namespace:SkiaSharp.Views.Maui.Controls;assembly=SkiaSharp.Views.Maui.Controls"
             x:Class="YessGoFront.Views.Controls.ScanMaskView">
    <Grid>
        <!-- Canvas for drawing overlay with hole in center -->
        <skia:SKCanvasView PaintSurface="OnCanvasViewPaintSurface"
                           EnableTouchEvents="False" />

        <!-- White scanning frame in center with rounded corners -->
        <Border BackgroundColor="Transparent"
                Stroke="White"
                StrokeThickness="2"
                StrokeShape="RoundRectangle 16,16,16,16"
                WidthRequest="280"
                HeightRequest="280"
                HorizontalOptions="Center"
                VerticalOptions="Center" />

        <!-- Corner indicators - Teal color -->
        <Grid HorizontalOptions="Center" VerticalOptions="Center">
            <!-- Top-left corner -->
            <BoxView Color="#00A985"
                     WidthRequest="30"
                     HeightRequest="3"
                     HorizontalOptions="Start"
                     VerticalOptions="Start"
                     TranslationY="-138" />
            <BoxView Color="#00A985"
                     WidthRequest="3"
                     HeightRequest="30"
                     HorizontalOptions="Start"
                     VerticalOptions="Start"
                     TranslationX="-138" />

            <!-- Top-right corner -->
            <BoxView Color="#00A985"
                     WidthRequest="30"
                     HeightRequest="3"
                     HorizontalOptions="End"
                     VerticalOptions="Start"
                     TranslationY="-138" />
            <BoxView Color="#00A985"
                     WidthRequest="3"
                     HeightRequest="30"
                     HorizontalOptions="End"
                     VerticalOptions="Start"
                     TranslationX="138" />

            <!-- Bottom-left corner -->
            <BoxView Color="#00A985"
                     WidthRequest="30"
                     HeightRequest="3"
                     HorizontalOptions="Start"
                     VerticalOptions="End"
                     TranslationY="138" />
            <BoxView Color="#00A985"
                     WidthRequest="3"
                     HeightRequest="30"
                     HorizontalOptions="Start"
                     VerticalOptions="End"
                     TranslationX="-138" />

            <!-- Bottom-right corner -->
            <BoxView Color="#00A985"
                     WidthRequest="30"
                     HeightRequest="3"
                     HorizontalOptions="End"
                     VerticalOptions="End"
                     TranslationY="138" />
            <BoxView Color="#00A985"
                     WidthRequest="3"
                     HeightRequest="30"
                     HorizontalOptions="End"
                     VerticalOptions="End"
                     TranslationX="138" />
        </Grid>
    </Grid>
</ContentView>
