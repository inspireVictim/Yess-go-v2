<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net9.0-android;net9.0-ios</TargetFrameworks>
		<OutputType>Exe</OutputType>
		<RootNamespace>YessGoFront</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<ApplicationTitle>YESS Go Front</ApplicationTitle>
		<ApplicationId>com.yessgo.front</ApplicationId>
		<ApplicationIdGuid>5F4C77F0-AC7A-4C4E-9E8B-32B6B1C9F22F</ApplicationIdGuid>

		<!-- ✅ Версии приложения для публикации -->
		<!-- Версия для Android -->
		<ApplicationVersion Condition="$(TargetFramework.Contains('-android'))">1</ApplicationVersion>
		<ApplicationDisplayVersion Condition="$(TargetFramework.Contains('-android'))">1.0.0</ApplicationDisplayVersion>
		
		<!-- Версия для iOS -->
		<CFBundleVersion Condition="$(TargetFramework.Contains('-ios'))">1</CFBundleVersion>
		<CFBundleShortVersionString Condition="$(TargetFramework.Contains('-ios'))">1.0.0</CFBundleShortVersionString>

		<!-- Минимальные версии платформ -->
		<SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('-android'))">24</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('-ios'))">15.0</SupportedOSPlatformVersion>

		<!-- Подавление предупреждений о версиях пакетов -->
		<NoWarn>$(NoWarn);NU1608;XC0045</NoWarn>

		<!-- Включение компиляции биндингов с Source для производительности -->
		<MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>

		<!-- Отключение XAML предупреждений для MainPage.xaml -->
		<MauiDisableXamlWarnings>MainPage.xaml</MauiDisableXamlWarnings>
	</PropertyGroup>

	<!-- ✅ Android -->
	<PropertyGroup Condition="$(TargetFramework.Contains('-android'))">
		<RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>

		<SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
		<AndroidMinSdkVersion>24</AndroidMinSdkVersion>

		<AndroidEnableProguard>false</AndroidEnableProguard>

		<!-- 🔥 Эти строки ОЧЕНЬ важны -->
		<AndroidAarPackagingMode>raw</AndroidAarPackagingMode>
		<AndroidUseAapt2>true</AndroidUseAapt2>
		<AndroidDexTool>d8</AndroidDexTool>
	</PropertyGroup>



	<!-- === FINIK SDK — ОБРАБОТКА AAR === -->
	<!-- 
	⚠️ ВАЖНО: Finik SDK 2.7.1 - это Flutter модуль, который НЕ МОЖЕТ быть подключен
	как стандартный Android AAR через автоматическую генерацию bindings в MAUI.
	
	SDK использует Flutter Engine внутри, поэтому стандартные Java bindings не работают.
	Мы используем подход через reflection для вызова SDK во время выполнения.
	
	Настройки для ПОЛНОГО отключения генерации bindings:
	- Bind=false: Отключает генерацию C# типов из AAR
	- GenerateJavaStubs=false: Запрещает генерацию Java stubs (критично!)
	- SkipAndroidManifestProcessing=true: Пропускает обработку AndroidManifest из AAR
	- AndroidAarPackagingMode=raw: Использует AAR как есть, без анализа
	- Compile Remove: Удаляет любые сгенерированные файлы из компиляции
	- Target RemoveFinikSdkBindings: Автоматически удаляет файлы после генерации
	-->
	<ItemGroup Condition="'$(TargetFramework)' == 'net9.0-android'">
		<!-- Подключаем AAR как обычную Android-библиотеку БЕЗ генерации bindings -->
		<AndroidLibrary Include="Platforms/Android/libs/android-sdk-2.7.1.aar">
			<Bind>false</Bind> <!-- Отключаем генерацию C# binding -->
			<GenerateJavaStubs>false</GenerateJavaStubs> <!-- Запрещаем генерацию Java stubs -->
			<SkipAndroidManifestProcessing>true</SkipAndroidManifestProcessing> <!-- Пропускаем обработку AndroidManifest -->
		</AndroidLibrary>
		
		<!-- УДАЛЯЕМ автоматически сгенерированные binding файлы из компиляции -->
		<!-- MAUI может пытаться генерировать их даже с Bind=false -->
		<Compile Remove="**/obj/**/KG.Finik.**.cs" />
		<Compile Remove="**/obj/**/kg.finik.**.cs" />
		<Compile Remove="**/obj/**/*Finik*.cs" />
		
		<!-- Помечаем как None, чтобы они не вызывали ошибки компиляции -->
		<None Include="**/obj/**/KG.Finik.**.cs" />
		<None Include="**/obj/**/kg.finik.**.cs" />
		<None Include="**/obj/**/*Finik*.cs" />
	</ItemGroup>


	<!-- ✅ iOS -->
	<PropertyGroup Condition="$(TargetFramework.Contains('-ios'))">
		<!-- Если собираешь под симулятор -->
		<RuntimeIdentifier>iossimulator-arm64</RuntimeIdentifier>
		<!-- Если нужно под реальное устройство, укажи при сборке:
		     dotnet build -f net9.0-ios -r ios-arm64 -->
	</PropertyGroup>

	<!-- ✅ Ресурсы -->
	<ItemGroup>
		<MauiImage Include="Resources\Images\**" />
		<MauiImage Include="Resources\Eye\**" />
		<MauiImage Include="Resources\PatnerDetailViewPage\**" />
		<MauiFont Include="Resources\Fonts\**" />
		<MauiSplashScreen Include="Resources\Splash\**" Color="FFFFFF" />
		<!-- Иконка приложения - MAUI автоматически создаст все необходимые размеры для Android и iOS -->
		<MauiIcon Include="Resources\AppIcon\appicon.png" />
	</ItemGroup>

	<!-- ✅ Пакеты -->
	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
		<PackageReference Include="Mapsui" Version="4.1.9" />
		<PackageReference Include="Mapsui.Maui" Version="4.1.9" />
		<PackageReference Include="Mapsui.Tiling" Version="4.1.9" />
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.0" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.0" />
		<PackageReference Include="Microsoft.Extensions.Http" Version="9.0.0" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="9.0.0" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="9.0.100" />
		<PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="9.0.100" />
		<PackageReference Include="Microsoft.Maui.Controls.Maps" Version="9.0.100" />
		<PackageReference Include="Microsoft.Maui.Essentials" Version="9.0.100" />
		<PackageReference Include="Plugin.Fingerprint" Version="2.1.5" />
		<PackageReference Include="SkiaSharp" Version="2.88.9" />
		<PackageReference Include="SkiaSharp.Views.Maui.Controls" Version="2.88.9" />
		<PackageReference Include="Svg.Skia" Version="1.0.0.3" />
		<PackageReference Include="ZXing.Net.Maui.Controls" Version="0.6.0" />
		<!-- Xamarin.AndroidX.Emoji2.ViewsHelper удален - несовместим с .NET 9 -->
		<!-- Используем TextWatcher вместо IInputFilter для блокировки emoji -->
	</ItemGroup>

	<ItemGroup>
		<MauiXaml Update="Views\**\*.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>
	</ItemGroup>

	<!-- Исключаем тестовые файлы из компиляции основного проекта -->
	<ItemGroup>
		<AndroidResource Remove="%2a%2a\**" />
		<Compile Remove="%2a%2a\**" />
		<Compile Remove="Tests\**" />
		<EmbeddedResource Remove="%2a%2a\**" />
		<EmbeddedResource Remove="Tests\**" />
		<MauiCss Remove="%2a%2a\**" />
		<MauiXaml Remove="%2a%2a\**" />
		<None Remove="%2a%2a\**" />
		<None Remove="Tests\**" />
	</ItemGroup>
	<ItemGroup>
	  <None Remove="%2a%2a/obj/%2a%2a/kg.finik.%2a%2a.cs" />
	  <None Remove="%2a%2a/obj/%2a%2a/KG.Finik.%2a%2a.cs" />
	  <None Remove="%2a%2a/obj/%2a%2a/kg.finik.%2a%2a.cs" />
	  <None Remove="%2a%2a/obj/%2a%2a/KG.Finik.%2a%2a.cs" />
	</ItemGroup>
	
	<ItemGroup>
	  <Compile Update="Views\ContactsPage.xaml.cs">
	    <DependentUpon>ContactsPage.xaml</DependentUpon>
	  </Compile>
	  <Compile Update="Views\RegisterPage.xaml.cs">
	    <DependentUpon>RegisterPage.xaml</DependentUpon>
	  </Compile>
	  <Compile Update="Views\PartnerDetailViewPage.xaml.cs">
	    <DependentUpon>PartnerDetailViewPage.xaml</DependentUpon>
	  </Compile>
	</ItemGroup>
	<ItemGroup>
	  <None Update="Views\FeedbackPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </None>
	  <MauiXaml Update="Views\RegisterPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Views\PartnerDetailViewPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'net9.0-android'">
	  <PackageReference Include="Xamarin.AndroidX.Activity">
	    <Version>1.11.0</Version>
	  </PackageReference>
	  <PackageReference Include="Xamarin.AndroidX.AppCompat">
	    <Version>1.7.1.1</Version>
	  </PackageReference>
	  <PackageReference Include="Xamarin.AndroidX.Core.Core.Ktx">
	    <Version>1.17.0</Version>
	  </PackageReference>
	  <PackageReference Include="Xamarin.AndroidX.Lifecycle.Common">
	    <Version>2.9.4</Version>
	  </PackageReference>
	  <PackageReference Include="Xamarin.AndroidX.Lifecycle.Runtime">
	    <Version>2.9.4</Version>
	  </PackageReference>
	  <PackageReference Include="Xamarin.Google.Android.Material">
	    <Version>1.13.0</Version>
	  </PackageReference>
	  <PackageReference Include="Xamarin.Kotlin.StdLib">
	    <Version>2.2.21</Version>
	  </PackageReference>
	  <PackageReference Include="Xamarin.Kotlin.StdLib.Common">
	    <Version>2.0.21.5</Version>
	  </PackageReference>
	  <PackageReference Include="Xamarin.Kotlin.StdLib.Jdk7">
	    <Version>2.2.21</Version>
	  </PackageReference>
	  <PackageReference Include="Xamarin.Kotlin.StdLib.Jdk8">
	    <Version>2.2.21</Version>
	  </PackageReference>
	</ItemGroup>
	
	<!-- ✅ Target для удаления сгенерированных bindings Finik SDK -->
	<!-- Выполняется на разных этапах сборки для гарантированного удаления -->
	<Target Name="RemoveFinikSdkBindings" AfterTargets="_GenerateJavaStubs;_ResolveLibraryProjectImports;_ExtractLibraryProjectImports" BeforeTargets="CoreCompile" Condition="'$(TargetFramework)' == 'net9.0-android'">
		<ItemGroup>
			<FinikBindingFiles Include="$(IntermediateOutputPath)**\KG.Finik.**.cs" />
			<FinikBindingFiles Include="$(IntermediateOutputPath)**\kg.finik.**.cs" />
			<FinikBindingFiles Include="$(IntermediateOutputPath)**\*Finik*.cs" />
			<FinikBindingFiles Include="$(OutputPath)**\KG.Finik.**.cs" />
			<FinikBindingFiles Include="$(OutputPath)**\kg.finik.**.cs" />
			<FinikBindingFiles Include="$(OutputPath)**\*Finik*.cs" />
		</ItemGroup>
		<Delete Files="@(FinikBindingFiles)" ContinueOnError="true" />
		<Message Text="[Finik SDK] Removed @(FinikBindingFiles-&gt;Count()) binding files" Importance="normal" Condition="'@(FinikBindingFiles)' != ''" />
	</Target>
	
	<!-- ✅ Дополнительный Target для удаления на этапе BeforeBuild -->
	<Target Name="RemoveFinikSdkBindingsBeforeBuild" BeforeTargets="BeforeBuild" Condition="'$(TargetFramework)' == 'net9.0-android'">
		<ItemGroup>
			<FinikBindingFilesBeforeBuild Include="$(IntermediateOutputPath)**\KG.Finik.**.cs" />
			<FinikBindingFilesBeforeBuild Include="$(IntermediateOutputPath)**\kg.finik.**.cs" />
			<FinikBindingFilesBeforeBuild Include="$(IntermediateOutputPath)**\*Finik*.cs" />
		</ItemGroup>
		<Delete Files="@(FinikBindingFilesBeforeBuild)" ContinueOnError="true" />
	</Target>
</Project>