<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:YessGoFront.Views.Controls"
             x:Class="YessGoFront.Views.PublicOfferPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F4F6F8">
    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Верхняя панель -->
        <Grid Padding="16,44,16,8" BackgroundColor="#0F6B53">
            <Grid ColumnDefinitions="Auto,*,Auto" VerticalOptions="Center">
                <Border WidthRequest="36" HeightRequest="36"
                        StrokeThickness="0"
                        BackgroundColor="#FFFFFF"
                        StrokeShape="RoundRectangle8">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped" />
                    </Border.GestureRecognizers>
                    <Image Source="back_arrow_icon.png" 
                        Aspect="AspectFit" 
                        Margin="8" />
                </Border>

                <Label Grid.Column="1"
                    Text="Публичная оферта"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    TextColor="White"
                    FontAttributes="Bold"
                    FontSize="18"/>
            </Grid>
        </Grid>
        
        <!-- Контент -->
        <ScrollView Grid.Row="1" Padding="16">
            <Label FontSize="14" TextColor="#6B7280" LineBreakMode="WordWrap">
                <Label.FormattedText>
                    <FormattedString>

                        <!-- Заголовок -->
                        <Span Text="ПУБЛИЧНАЯ ОФЕРТА" FontAttributes="Bold" FontSize="20"/>
                        <Span Text="&#10;На оказание услуг через мобильное приложение YESS!GO" FontSize="16"/>
                        <Span Text="&#10;г. Бишкек, Кыргызстан" />
                        <Span Text="&#10;&#10;" />

                        <!-- 1. Общие положения -->
                        <Span Text="1. ОБЩИЕ ПОЛОЖЕНИЯ" FontAttributes="Bold"/>
                        <Span Text="&#10;--------------------------------------&#10;" />

                        <Span Text="1.1. Настоящий документ является публичной офертой (далее — «Оферта») в адрес физических и юридических лиц (далее — «Пользователь») о заключении договора на оказание услуг через мобильное приложение YESS!GO (далее — «Приложение», «Сервис»)." />
                        <Span Text="&#10;&#10;" />

                        <Span Text="1.2. Исполнитель услуг: [Укажите полное наименование юридического лица]" />
                        <Span Text="&#10;&#10;" />

                        <Span Text="1.3. Использование Приложения означает полное и безоговорочное принятие Пользователем условий настоящей Оферты." />
                        <Span Text="&#10;&#10;" />

                        <Span Text="1.4. Настоящая Оферта вступает в силу с момента её публикации в Приложении и действует до её отзыва." />
                        <Span Text="&#10;&#10;" />

                        <!-- 2. Предмет оферты -->
                        <Span Text="2. ПРЕДМЕТ ОФЕРТЫ" FontAttributes="Bold"/>
                        <Span Text="&#10;--------------------------------------&#10;" />

                        <Span Text="2.1. Исполнитель обязуется предоставить Пользователю следующие услуги:" />
                        <Span Text="&#10;• Доступ к платформе лояльности YESS!GO" />
                        <Span Text="&#10;• Возможность оплаты товаров и услуг" />
                        <Span Text="&#10;• Информация о партнёрах, акциях и предложениях" />
                        <Span Text="&#10;&#10;" />

                        <Span Text="2.2. Пользователь обязуется использовать Приложение в соответствии с условиями Оферты." />
                        <Span Text="&#10;&#10;" />

                        <!-- 3. Регистрация -->
                        <Span Text="3. ПОРЯДОК РЕГИСТРАЦИИ И ИСПОЛЬЗОВАНИЯ" FontAttributes="Bold"/>
                        <Span Text="&#10;--------------------------------------&#10;" />

                        <Span Text="3.1. Для использования Приложения Пользователь должен пройти регистрацию, предоставив достоверные данные." />
                        <Span Text="&#10;&#10;" />

                        <Span Text="3.2. Регистрация считается завершённой после подтверждения номера телефона через SMS-код." />
                        <Span Text="&#10;&#10;" />

                        <Span Text="3.3. Пользователь несёт ответственность за сохранность данных для входа." />
                        <Span Text="&#10;&#10;" />

                        <!-- 4. Цены и оплата -->
                        <Span Text="4. ЦЕНЫ И ОПЛАТА" FontAttributes="Bold"/>
                        <Span Text="&#10;--------------------------------------&#10;" />

                        <Span Text="4.1. Использование базового функционала — бесплатное." />
                        <Span Text="&#10;&#10;" />

                        <Span Text="4.3. Окончательная цена при оплате через Приложение совпадает с ценой при оплате другими способами." />
                        <Span Text="&#10;&#10;" />

                        <Span Text="4.4. Формы оплаты:" />
                        <Span Text="&#10;• Банковские карты" />
                        <Span Text="&#10;• Электронные кошельки" />
                        <Span Text="&#10;• Иные доступные способы" />
                        <Span Text="&#10;&#10;" />

                        <!-- 6. Ответственность -->
                        <Span Text="5. ОТВЕТСТВЕННОСТЬ СТОРОН" FontAttributes="Bold"/>
                        <Span Text="&#10;--------------------------------------&#10;" />

                        <Span Text="5.1. Исполнитель не несёт ответственности за качество товаров и услуг партнёров." />
                        <Span Text="&#10;&#10;" />

                        <Span Text="5.2. Исполнитель не несёт ответственности за ущерб, возникший из-за невозможности использования Приложения." />
                        <Span Text="&#10;&#10;" />

                        <Span Text="5.3. Пользователь несёт ответственность за данные, предоставленные при регистрации." />
                        <Span Text="&#10;&#10;" />

                        <!-- 7. Изменение оферты -->
                        <Span Text="6. ИЗМЕНЕНИЕ УСЛОВИЙ ОФЕРТЫ" FontAttributes="Bold"/>
                        <Span Text="&#10;--------------------------------------&#10;" />

                        <Span Text="6.1. Исполнитель может изменять условия Оферты в любое время." />
                        <Span Text="&#10;&#10;" />

                        <Span Text="6.2. Пользователи уведомляются о значимых изменениях через Приложение." />
                        <Span Text="&#10;&#10;" />

                        <Span Text="6.3. Продолжение использования Приложения означает согласие с новыми условиями." />
                        <Span Text="&#10;&#10;" />

                        <!-- 8. Споры -->
                        <Span Text="7. РАЗРЕШЕНИЕ СПОРОВ" FontAttributes="Bold"/>
                        <Span Text="&#10;--------------------------------------&#10;" />

                        <Span Text="7.1. Споры решаются путём переговоров." />
                        <Span Text="&#10;&#10;" />

                        <Span Text="7.2. В случае недостижения согласия — в соответствии с законодательством Кыргызской Республики." />
                        <Span Text="&#10;&#10;" />

                        <!-- 9. Контакты -->
                        <Span Text="8. КОНТАКТНАЯ ИНФОРМАЦИЯ" FontAttributes="Bold"/>
                        <Span Text="&#10;--------------------------------------&#10;" />

                        <Span Text="📧 Email: support@yessgo.kg" />
                        <Span Text="&#10;📞 Телефон: +996 (990) 500 757" />
                        <Span Text="&#10;🌐 Сайт: www.yessgo.kg" />
                        <Span Text="&#10;📍 Адрес: г. Бишкек, ул. Токтогула, 87" />

                    </FormattedString>
                </Label.FormattedText>
            </Label>
        </ScrollView>


        <!-- Нижний навбар -->
        <controls:BottomNavBar x:Name="BottomBar" Grid.Row="2" />
    </Grid>
</ContentPage>

