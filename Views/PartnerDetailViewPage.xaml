<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:YessGoFront.Converters"
             xmlns:viewmodels="clr-namespace:YessGoFront.ViewModels"
             xmlns:helpers="clr-namespace:YessGoFront.Helpers"
             x:Class="YessGoFront.Views.PartnerDetailViewPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F9F9F9">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:StringToImageSourceConverter x:Key="StringToImageSourceConverter" />
            <converters:IsNotNullConverter x:Key="IsNotNullConverter" />
            <converters:IsNullConverter x:Key="IsNullConverter" />
            <converters:StringEqualsConverter x:Key="StringEqualsConverter" />
            <converters:IntToBoolConverter x:Key="IntToBoolConverter" />
            <converters:InverseIntToBoolConverter x:Key="InverseIntToBoolConverter" />
            <converters:RatingToColorConverter x:Key="RatingToColorConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">
        <!-- Зеленая панель с иконками -->
        <Border Grid.Row="0"
                BackgroundColor="#0B4A3B"
                StrokeThickness="0"
                Padding="16,12">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Иконка назад слева -->
                <ImageButton Grid.Column="0"
                             Source="back_partner.svg"
                             WidthRequest="30"
                             HeightRequest="30"
                             BackgroundColor="Transparent"
                             Aspect="AspectFit"
                             Clicked="OnBackButtonClicked"/>
                
                <!-- Пустое пространство в центре -->
                <BoxView Grid.Column="1" Color="Transparent"/>
                
                <!-- Иконка корзины справа -->
                <ImageButton Grid.Column="2"
                             Source="basket.svg"
                             WidthRequest="30"
                             HeightRequest="30"
                             BackgroundColor="Transparent"
                             Aspect="AspectFit"
                             Clicked="OnBasketButtonClicked"/>
            </Grid>
        </Border>

        <ScrollView Grid.Row="1">
        <VerticalStackLayout Spacing="0">
            <!-- Основной контент -->
            <VerticalStackLayout Spacing="16" Padding="20" BackgroundColor="#F9F9F9">
                <!-- Логотип и название -->
                <HorizontalStackLayout Spacing="16" VerticalOptions="Start">
                    <!-- Логотип -->
                    <Frame x:Name="LogoFrame"
                           WidthRequest="80"
                           HeightRequest="80"
                           CornerRadius="40"
                           Padding="4"
                           BackgroundColor="White"
                           HasShadow="True"
                           HorizontalOptions="Start">
                        <Grid>
                            <!-- Изображение (только если LogoImageSource не пустой) -->
                            <Image Source="{Binding LogoImageSource}"
                                   Aspect="AspectFit"
                                   HorizontalOptions="Fill"
                                   VerticalOptions="Fill"
                                   IsVisible="{Binding IsLogoImageVisible}">
								<Image.Behaviors>
									<helpers:ImageLoadingBehavior />
								</Image.Behaviors>
							</Image>
                            
                            <!-- Текст с именем партнёра (если LogoImageSource пустой) -->
                            <Label Text="{Binding LogoText}"
                                   TextColor="#DC2626"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center"
                                   HorizontalOptions="Fill"
                                   VerticalOptions="Fill"
                                   MaxLines="2"
                                   LineBreakMode="TailTruncation"
                                   IsVisible="{Binding IsLogoTextVisible}" />
                        </Grid>
                    </Frame>

                    <!-- Название бренда -->
                    <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                        <Label Text="{Binding PartnerName}"
                               FontSize="28"
                               FontAttributes="Bold"
                               TextColor="Black"
                               HorizontalOptions="Start"/>
                    </VerticalStackLayout>
                </HorizontalStackLayout>

                <!-- Описание партнёра -->
                <Label Text="{Binding PartnerDescription}"
                       FontSize="14"
                       TextColor="#666"
                       LineBreakMode="WordWrap"
                       Margin="0,8,0,0"
                       IsVisible="{Binding PartnerDescription, Converter={StaticResource IsNotNullConverter}}"/>

                <!-- Промо и рейтинг -->
                <HorizontalStackLayout Spacing="16" VerticalOptions="Center">
                    <!-- Промо-бейдж -->
                    <Border BackgroundColor="#10B981"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 8"
                            Padding="12,6"
                            IsVisible="{Binding IsPromoVisible}">
                        <HorizontalStackLayout Spacing="6">
                            <Label Text="{Binding PromoPercent}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="White"/>
                            <Label Text="{Binding PromoText}"
                                   FontSize="12"
                                   TextColor="White"/>
                        </HorizontalStackLayout>
                    </Border>

                    <!-- Рейтинг -->
                    <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                        <Label Text="👍"
                               FontSize="16"
                               VerticalOptions="Center"/>
                        <Label x:Name="RatingLabel"
                               Text="100% (500+)"
                               FontSize="14"
                               TextColor="#666"
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </HorizontalStackLayout>

                <!-- Товары и отзывы -->
                <Grid ColumnDefinitions="*,Auto" Margin="0,16,0,16">
                    <HorizontalStackLayout Grid.Column="0" Spacing="12">
                        <Button Text="Товары"
                                Command="{Binding SelectTabCommand}"
                                CommandParameter="Products"
                                FontSize="16"
                                FontAttributes="Bold"
                                CornerRadius="8"
                                Padding="20,12"
                                BackgroundColor="#E0E0E0"
                                TextColor="#666">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" 
                                           Binding="{Binding SelectedTab, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Products}" 
                                           Value="True">
                                    <Setter Property="BackgroundColor" Value="#0B4A3B" />
                                    <Setter Property="TextColor" Value="White" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <Button Text="Отзывы"
                                Command="{Binding SelectTabCommand}"
                                CommandParameter="Reviews"
                                FontSize="16"
                                FontAttributes="Bold"
                                CornerRadius="8"
                                Padding="20,12"
                                BackgroundColor="#E0E0E0"
                                TextColor="#666">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" 
                                           Binding="{Binding SelectedTab, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Reviews}" 
                                           Value="True">
                                    <Setter Property="BackgroundColor" Value="#0B4A3B" />
                                    <Setter Property="TextColor" Value="White" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                    </HorizontalStackLayout>
                    
                    <!-- Иконки социальных сетей -->
                    <HorizontalStackLayout Grid.Column="1" Spacing="12" VerticalOptions="Center">
                        <ImageButton Source="PatnerDetailViewPage/skill_icons_instagram.svg"
                                     WidthRequest="24"
                                     HeightRequest="24"
                                     BackgroundColor="Transparent"
                                     Aspect="AspectFit"/>
                        <ImageButton Source="PatnerDetailViewPage/logos_whatsapp_icon.svg"
                                     WidthRequest="24"
                                     HeightRequest="24"
                                     BackgroundColor="Transparent"
                                     Aspect="AspectFit"/>
                        <ImageButton Source="PatnerDetailViewPage/image_254.svg"
                                     WidthRequest="24"
                                     HeightRequest="24"
                                     BackgroundColor="Transparent"
                                     Aspect="AspectFit"/>
                        <ImageButton Source="PatnerDetailViewPage/famicons_call.svg"
                                     WidthRequest="24"
                                     HeightRequest="24"
                                     BackgroundColor="Transparent"
                                     Aspect="AspectFit"/>
                    </HorizontalStackLayout>
                </Grid>

                <!-- Контент товаров -->
                <VerticalStackLayout>
                    <VerticalStackLayout.Triggers>
                        <DataTrigger TargetType="VerticalStackLayout" 
                                   Binding="{Binding SelectedTab, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Products}" 
                                   Value="False">
                            <Setter Property="IsVisible" Value="False" />
                        </DataTrigger>
                    </VerticalStackLayout.Triggers>
                    <!-- Список продуктов -->
                    <HorizontalStackLayout Spacing="8" Margin="0,8,0,8">
                        <Label Text="Продукты"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="Black"/>
                        <Label Text="{Binding Products.Count, StringFormat='({0})'}"
                               FontSize="16"
                               TextColor="#666"
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>

                    <!-- Кнопки категорий -->
                    <ScrollView x:Name="CategoriesScrollView"
                                Orientation="Horizontal" 
                                HorizontalScrollBarVisibility="Never"
                                Margin="0,8,0,12"
                                IsVisible="{Binding Categories.Count, Converter={StaticResource IntToBoolConverter}}">
                        <HorizontalStackLayout Spacing="8" 
                                             BindableLayout.ItemsSource="{Binding Categories}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Button Text="{Binding .}"
                                            FontSize="14"
                                            FontAttributes="Bold"
                                            CornerRadius="20"
                                            Padding="16,8"
                                            BackgroundColor="#E0E0E0"
                                            TextColor="#666"
                                            Margin="0"
                                            Clicked="OnCategoryButtonClicked"
                                            CommandParameter="{Binding .}">
                                    </Button>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>
                    </ScrollView>

                    <!-- Сообщение, если продуктов нет -->
                    <Label x:Name="EmptyProductsLabel"
                           Text="Продукты для этого партнёра пока не добавлены в базу данных"
                           FontSize="14"
                           TextColor="#999"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           Margin="20"
                           IsVisible="False"/>

                    <CollectionView ItemsSource="{Binding Products}"
                                SelectionMode="None"
                                ItemSizingStrategy="MeasureAllItems">
                        <CollectionView.ItemsLayout>
                            <GridItemsLayout Orientation="Vertical" Span="2" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Stroke="#0B4A3B"
                                        StrokeThickness="2"
                                        StrokeShape="RoundRectangle 12"
                                        BackgroundColor="White"
                                        Padding="0"
                                        Margin="4,0,4,12"
                                        HorizontalOptions="Fill">
                                    <Border.Shadow>
                                        <Shadow Brush="#1A000000" 
                                                Offset="0,2" 
                                                Radius="8" 
                                                Opacity="0.1"/>
                                    </Border.Shadow>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnProductTapped" CommandParameter="{Binding .}"/>
                                    </Border.GestureRecognizers>
                                    <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*">
                                        <!-- Изображение продукта -->
                                        <Grid Grid.Row="0"
                                              IsVisible="{Binding ImageUrl, Converter={StaticResource IsNotNullConverter}}">
                                            <Image Source="{Binding ImageUrl, Converter={StaticResource StringToImageSourceConverter}}"
                                                   Aspect="AspectFill"
                                                   HeightRequest="120"
                                                   HorizontalOptions="Fill">
                                                <Image.Behaviors>
                                                    <helpers:ImageLoadingBehavior />
                                                </Image.Behaviors>
                                            </Image>
                                            
                                            <!-- Бейдж скидки (показываем только если есть скидка) -->
                                            <AbsoluteLayout IsVisible="{Binding DiscountPercent, Converter={StaticResource IsNotNullConverter}}">
                                                <Border AbsoluteLayout.LayoutBounds="8,8,50,20"
                                                        AbsoluteLayout.LayoutFlags="None"
                                                        BackgroundColor="#10B981"
                                                        StrokeThickness="0"
                                                        StrokeShape="RoundRectangle 6"
                                                        Padding="6,3">
                                                    <Label Text="{Binding DiscountPercent, StringFormat='-{0:F0}%'}"
                                                           FontSize="10"
                                                           FontAttributes="Bold"
                                                           TextColor="White"/>
                                                </Border>
                                            </AbsoluteLayout>
                                        </Grid>

                                        <!-- Название продукта -->
                                        <VerticalStackLayout Grid.Row="1" Spacing="2" Margin="8,8,8,4">
                                            <Label Text="{Binding Name}"
                                                   FontSize="14"
                                                   FontAttributes="Bold"
                                                   TextColor="Black"
                                                   LineBreakMode="TailTruncation"
                                                   MaxLines="2"/>
                                        </VerticalStackLayout>

                                        <!-- Цена -->
                                        <VerticalStackLayout Grid.Row="2"
                                                             Spacing="2"
                                                             Margin="8,0,8,4">
                                            <!-- Старая цена (зачеркнутая, показываем только если есть) -->
                                            <Label Text="{Binding OriginalPrice, StringFormat='{0:F0} сом'}"
                                                   FontSize="11"
                                                   TextColor="#999"
                                                   TextDecorations="Strikethrough"
                                                   HorizontalOptions="Start"
                                                   IsVisible="{Binding OriginalPrice, Converter={StaticResource IsNotNullConverter}}"/>
                                            
                                            <!-- Новая цена и монеты -->
                                            <HorizontalStackLayout Spacing="3" HorizontalOptions="Start">
                                                <Label Text="{Binding Price, StringFormat='{0:F0} сом'}"
                                                       FontSize="16"
                                                       FontAttributes="Bold"
                                                       TextColor="Black"/>
                                                <!-- Yess!Coins (показываем только если есть) -->
                                                <Label Text="{Binding EffectiveYessCoins, StringFormat='+{0:F0}'}"
                                                       FontSize="11"
                                                       TextColor="#DC2626"
                                                       VerticalOptions="Center"
                                                       IsVisible="{Binding EffectiveYessCoins, Converter={StaticResource IsNotNullConverter}}"/>
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>

                                        <!-- Кнопка покупки -->
                                        <Button Grid.Row="3"
                                                Text="В корзину"
                                                BackgroundColor="#FF9800"
                                                TextColor="White"
                                                FontSize="12"
                                                FontAttributes="Bold"
                                                CornerRadius="6"
                                                Padding="8,6"
                                                Margin="8,0,8,8"
                                                HorizontalOptions="Fill"
                                                Clicked="OnAddToCartClicked"
                                                CommandParameter="{Binding .}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <!-- Контент отзывов -->
                <VerticalStackLayout Spacing="16" Margin="0,8,0,0">
                    <VerticalStackLayout.Triggers>
                        <DataTrigger TargetType="VerticalStackLayout" 
                                   Binding="{Binding SelectedTab, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Reviews}" 
                                   Value="False">
                            <Setter Property="IsVisible" Value="False" />
                        </DataTrigger>
                    </VerticalStackLayout.Triggers>

                    <!-- Заголовок и кнопка -->
                    <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,8">
                        <Label Grid.Column="0"
                               Text="Отзывы"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="Black"
                               VerticalOptions="Center"/>
                        <Button Grid.Column="1"
                                Text="Оставить отзыв"
                                Command="{Binding ShowReviewFormCommand}"
                                BackgroundColor="#0B4A3B"
                                TextColor="White"
                                FontSize="14"
                                FontAttributes="Bold"
                                CornerRadius="8"
                                Padding="16,8"
                                VerticalOptions="Center"/>
                    </Grid>

                    <!-- Форма отзыва -->
                    <Frame BackgroundColor="White"
                           CornerRadius="12"
                           Padding="16"
                           Margin="0,0,0,12"
                           HasShadow="True"
                           IsVisible="{Binding IsReviewFormVisible}">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="Оставить отзыв"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="Black"/>
                            
                            <!-- Имя автора (опционально) -->
                            <Entry Text="{Binding ReviewAuthorName}"
                                   Placeholder="Ваше имя (необязательно)"
                                   FontSize="14"
                                   BackgroundColor="#F5F5F5"
                                   PlaceholderColor="#999"/>
                            
                            <!-- Рейтинг -->
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Оценка:"
                                       FontSize="14"
                                       TextColor="#666"/>
                                <HorizontalStackLayout Spacing="8">
                                    <Button Text="1"
                                            FontSize="16"
                                            CornerRadius="20"
                                            WidthRequest="40"
                                            HeightRequest="40"
                                            BackgroundColor="{Binding ReviewRating, Converter={StaticResource RatingToColorConverter}, ConverterParameter=1}"
                                            TextColor="White"
                                            Command="{Binding SelectRatingCommand}"
                                            CommandParameter="1"/>
                                    <Button Text="2"
                                            FontSize="16"
                                            CornerRadius="20"
                                            WidthRequest="40"
                                            HeightRequest="40"
                                            BackgroundColor="{Binding ReviewRating, Converter={StaticResource RatingToColorConverter}, ConverterParameter=2}"
                                            TextColor="White"
                                            Command="{Binding SelectRatingCommand}"
                                            CommandParameter="2"/>
                                    <Button Text="3"
                                            FontSize="16"
                                            CornerRadius="20"
                                            WidthRequest="40"
                                            HeightRequest="40"
                                            BackgroundColor="{Binding ReviewRating, Converter={StaticResource RatingToColorConverter}, ConverterParameter=3}"
                                            TextColor="White"
                                            Command="{Binding SelectRatingCommand}"
                                            CommandParameter="3"/>
                                    <Button Text="4"
                                            FontSize="16"
                                            CornerRadius="20"
                                            WidthRequest="40"
                                            HeightRequest="40"
                                            BackgroundColor="{Binding ReviewRating, Converter={StaticResource RatingToColorConverter}, ConverterParameter=4}"
                                            TextColor="White"
                                            Command="{Binding SelectRatingCommand}"
                                            CommandParameter="4"/>
                                    <Button Text="5"
                                            FontSize="16"
                                            CornerRadius="20"
                                            WidthRequest="40"
                                            HeightRequest="40"
                                            BackgroundColor="{Binding ReviewRating, Converter={StaticResource RatingToColorConverter}, ConverterParameter=5}"
                                            TextColor="White"
                                            Command="{Binding SelectRatingCommand}"
                                            CommandParameter="5"/>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                            
                            <!-- Текст отзыва -->
                            <Editor Text="{Binding ReviewText}"
                                    Placeholder="Напишите ваш отзыв..."
                                    FontSize="14"
                                    BackgroundColor="#F5F5F5"
                                    PlaceholderColor="#999"
                                    HeightRequest="100"
                                    AutoSize="TextChanges"/>
                            
                            <!-- Кнопки -->
                            <HorizontalStackLayout Spacing="12">
                                <Button Text="Отмена"
                                        Command="{Binding HideReviewFormCommand}"
                                        BackgroundColor="#E0E0E0"
                                        TextColor="#666"
                                        FontSize="14"
                                        CornerRadius="8"
                                        Padding="16,8"
                                        HorizontalOptions="FillAndExpand"/>
                                <Button Text="Отправить"
                                        Command="{Binding SubmitReviewCommand}"
                                        BackgroundColor="#0B4A3B"
                                        TextColor="White"
                                        FontSize="14"
                                        FontAttributes="Bold"
                                        CornerRadius="8"
                                        Padding="16,8"
                                        HorizontalOptions="FillAndExpand"/>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Frame>

                    <!-- Список отзывов -->
                    <CollectionView ItemsSource="{Binding Reviews}"
                                    SelectionMode="None"
                                    IsVisible="{Binding Reviews.Count, Converter={StaticResource IntToBoolConverter}}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Frame BackgroundColor="White"
                                       CornerRadius="12"
                                       Padding="16"
                                       Margin="0,0,0,12"
                                       HasShadow="True">
                                    <VerticalStackLayout Spacing="8">
                                        <!-- Заголовок отзыва -->
                                        <Grid ColumnDefinitions="*,Auto">
                                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                                <Label Text="{Binding AuthorName}"
                                                       FontSize="16"
                                                       FontAttributes="Bold"
                                                       TextColor="Black"/>
                                                <Label Text="{Binding CreatedAt, StringFormat='{0:dd.MM.yyyy HH:mm}'}"
                                                       FontSize="12"
                                                       TextColor="#999"/>
                                            </VerticalStackLayout>
                                            <!-- Рейтинг -->
                                            <HorizontalStackLayout Grid.Column="1" Spacing="2">
                                                <Label Text="⭐"
                                                       FontSize="16"
                                                       VerticalOptions="Center"/>
                                                <Label Text="{Binding Rating}"
                                                       FontSize="16"
                                                       FontAttributes="Bold"
                                                       TextColor="#FF9800"
                                                       VerticalOptions="Center"/>
                                            </HorizontalStackLayout>
                                        </Grid>
                                        
                                        <!-- Текст отзыва -->
                                        <Label Text="{Binding Text}"
                                               FontSize="14"
                                               TextColor="#666"
                                               LineBreakMode="WordWrap"/>
                                    </VerticalStackLayout>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- Заглушка, если отзывов нет -->
                    <Frame BackgroundColor="White"
                           CornerRadius="12"
                           Padding="16"
                           Margin="0,0,0,12"
                           HasShadow="True"
                           IsVisible="{Binding Reviews.Count, Converter={StaticResource InverseIntToBoolConverter}}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Отзывы пока отсутствуют"
                                   FontSize="14"
                                   TextColor="#999"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                            <Label Text="Будьте первым, кто оставит отзыв об этом партнёре!"
                                   FontSize="12"
                                   TextColor="#666"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center"
                                   LineBreakMode="WordWrap"/>
                        </VerticalStackLayout>
                    </Frame>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>

