<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="YessGoFront.Views.QrPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:zxing="clr-namespace:ZXing.Net.Maui.Controls;assembly=ZXing.Net.MAUI.Controls"
    xmlns:controls="clr-namespace:YessGoFront.Views.Controls"
    BackgroundColor="Black">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- CAMERA - Full Screen -->
        <zxing:CameraBarcodeReaderView
            x:Name="BarCodeReader"
            Grid.RowSpan="3"
            BarcodesDetected="BarCodeReader_BarcodesDetected"
            IsTorchOn="{Binding IsTorchOn}"
            IsDetecting="False"
            HorizontalOptions="Fill"
            VerticalOptions="Fill"/>

        <!-- FULL MASK WITH HOLE -->
        <controls:ScanMaskView
            Grid.RowSpan="3"
            HorizontalOptions="Fill"
            VerticalOptions="Fill"
            InputTransparent="True"/>

        <!-- NAV BAR - Dark overlay -->
        <Border Grid.Row="0"
                BackgroundColor="#80000000"
                StrokeThickness="0"
                HeightRequest="60"
                Padding="16">
            <Grid ColumnDefinitions="Auto,*,Auto">

                <!-- Back button - Dark grey rounded -->
                <Border Grid.Column="0"
                        BackgroundColor="#404040"
                        StrokeThickness="0"
                        WidthRequest="40"
                        HeightRequest="40"
                        StrokeShape="RoundRectangle 8,8,0,0">
                    <ImageButton Source="back_icon.png"
                                 WidthRequest="24"
                                 HeightRequest="24"
                                 BackgroundColor="Transparent"
                                 Command="{Binding ExitCommand}"/>
                </Border>

                <Label Grid.Column="1"
                       Text="Сканирование QR"
                       FontSize="20"
                       FontAttributes="Bold"
                       VerticalOptions="Center"
                       HorizontalOptions="Center"
                       TextColor="White"/>

                <!-- Placeholder for symmetry -->
                <BoxView Grid.Column="2"
                         WidthRequest="40"
                         Color="Transparent"/>
            </Grid>
        </Border>

        <!-- BOTTOM CARD - Dark panel -->
        <Border Grid.Row="2"
                BackgroundColor="#80000000"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 22,22,0,0"
                Margin="16,0,16,20"
                Padding="20">

            <VerticalStackLayout Spacing="16">

                <!-- Title section -->
                <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                    <Label Text="Сканируйте QR-код"
                           FontSize="18"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           TextColor="White" />
                    <Label Text="Отсканируйте чек, чтобы получить бонусы"
                           FontSize="13"
                           HorizontalOptions="Center"
                           TextColor="#CCFFFFFF" />
                </VerticalStackLayout>

                <!-- Action buttons -->
                <HorizontalStackLayout Spacing="12" HorizontalOptions="Center">

                    <!-- My QR Button - Light grey -->
                    <Button Text="Мой QR"
                            ImageSource="qr_my_icon.png"
                            BackgroundColor="#F0F0F0"
                            TextColor="#666666"
                            Padding="14,10"
                            WidthRequest="130"
                            CornerRadius="14"
                            Command="{Binding ShowMyQrCommand}" />

                    <!-- Flash button - Circular with light grey background -->
                    <Border BackgroundColor="#F0F0F0"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 17,17,0,0"
                            WidthRequest="34"
                            HeightRequest="34">
                        <ImageButton Source="flash_icon.png"
                                     WidthRequest="20"
                                     HeightRequest="20"
                                     BackgroundColor="Transparent"
                                     Command="{Binding ToggleFlashCommand}" />
                    </Border>
                </HorizontalStackLayout>

                <!-- Back button - Red -->
                <Button Text="Назад"
                        BackgroundColor="#D9534F"
                        TextColor="White"
                        FontSize="16"
                        FontAttributes="Bold"
                        CornerRadius="14"
                        Padding="14,10"
                        Command="{Binding ExitCommand}" />
            </VerticalStackLayout>
        </Border>

        <!-- QR OVERLAY -->
        <Grid
            x:Name="QrOverlay"
            IsVisible="{Binding IsQrOverlayOpen}"
            BackgroundColor="#70000000"
            Grid.RowSpan="3">

            <Frame CornerRadius="20"
                   BackgroundColor="White"
                   Padding="20"
                   WidthRequest="300"
                   VerticalOptions="Center"
                   HorizontalOptions="Center">

                <VerticalStackLayout Spacing="20"
                                     HorizontalOptions="Center">

                    <Image Source="{Binding MyQrImagePath}"
                           WidthRequest="220"
                           HeightRequest="220"
                           Aspect="AspectFit" />

                    <Button Text="Закрыть"
                            BackgroundColor="#00A985"
                            TextColor="White"
                            CornerRadius="14"
                            Command="{Binding CloseQrCommand}" />
                </VerticalStackLayout>
            </Frame>
        </Grid>

    </Grid>

</ContentPage>