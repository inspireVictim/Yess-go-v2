<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="YessGoFront.Views.Acquiring"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F9F9F9">

    <Grid RowDefinitions="Auto,*">
        <!-- Заголовок -->
        <Border Grid.Row="0"
                BackgroundColor="#0B4A3B"
                StrokeThickness="0"
                Padding="16,12">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Кнопка назад -->
                <ImageButton Grid.Column="0"
                             Source="back_partner.svg"
                             WidthRequest="30"
                             HeightRequest="30"
                             BackgroundColor="Transparent"
                             Aspect="AspectFit"
                             Clicked="OnBackButtonClicked"/>
                
                <!-- Заголовок -->
                <Label Grid.Column="1"
                       Text="Пополнение баланса"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="White"
                       VerticalOptions="Center"
                       HorizontalOptions="Center"/>
                
                <!-- Пустое место справа для балансировки -->
                <BoxView Grid.Column="2" 
                         WidthRequest="30"
                         Color="Transparent"/>
            </Grid>
        </Border>

        <!-- Контент -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="16" Padding="16">
                <!-- Информация о сумме -->
                <Frame BackgroundColor="White"
                       CornerRadius="16"
                       HasShadow="True"
                       Padding="20">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Сумма пополнения"
                               FontSize="14"
                               TextColor="#666"
                               HorizontalOptions="Center"/>
                        <Label x:Name="AmountLabel"
                               Text="0 KGS"
                               FontSize="32"
                               FontAttributes="Bold"
                               TextColor="#0B4A3B"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Заглушка для эквайринга -->
                <Frame BackgroundColor="White"
                       CornerRadius="16"
                       HasShadow="True"
                       Padding="20">
                    <VerticalStackLayout Spacing="16">
                        <Label Text="Выберите способ оплаты"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#0B4A3B"
                               HorizontalOptions="Center"/>
                        
                        <Label Text="Здесь будет интеграция с эквайрингом"
                               FontSize="14"
                               TextColor="#666"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"
                               LineBreakMode="WordWrap"/>
                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>