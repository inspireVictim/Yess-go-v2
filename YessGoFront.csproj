<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net9.0-android;net9.0-ios</TargetFrameworks>
		<OutputType>Exe</OutputType>
		<RootNamespace>YessGoFront</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<ApplicationTitle>Yess!Go</ApplicationTitle>
		<ApplicationId>com.yessgo.front</ApplicationId>
		<ApplicationIdGuid>5F4C77F0-AC7A-4C4E-9E8B-32B6B1C9F22F</ApplicationIdGuid>

		<!-- ✅ Версии приложения для публикации -->
		<!-- Версия для Android -->
		<ApplicationVersion Condition="$(TargetFramework.Contains('-android'))">1</ApplicationVersion>
		<ApplicationDisplayVersion Condition="$(TargetFramework.Contains('-android'))">1.0.0</ApplicationDisplayVersion>
		
		<!-- Версия для iOS -->
		<CFBundleVersion Condition="$(TargetFramework.Contains('-ios'))">1</CFBundleVersion>
		<CFBundleShortVersionString Condition="$(TargetFramework.Contains('-ios'))">1.0.0</CFBundleShortVersionString>

		<!-- Минимальные версии платформ -->
		<!-- Android 23 (6.0) требуется для androidx.savedstate и других зависимостей -->
		<!-- Это все еще поддерживает ~90% всех Android устройств -->
		<SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('-android'))">23</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('-ios'))">15.0</SupportedOSPlatformVersion>

		<!-- Подавление предупреждений о версиях пакетов -->
		<NoWarn>$(NoWarn);NU1608;XC0045</NoWarn>

		<!-- Включение компиляции биндингов с Source для производительности -->
		<MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>

		<!-- Отключение XAML предупреждений для MainPage.xaml -->
		<MauiDisableXamlWarnings>MainPage.xaml</MauiDisableXamlWarnings>
	</PropertyGroup>

	<!-- ✅ Android -->
	<PropertyGroup Condition="$(TargetFramework.Contains('-android'))">
		<RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>

		<!-- Поддерживаем Android начиная с API 23 (Android 6.0 Marshmallow) -->
		<!-- API 23 требуется для androidx.savedstate и других зависимостей -->
		<!-- Это все еще поддерживает ~90% всех Android устройств -->
		<SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>
		<AndroidMinSdkVersion>23</AndroidMinSdkVersion>

		<!-- Важное: в Release не трогаем наши сборки (особенно ZXing), только системные -->
		<!-- Это предотвращает вырезание кода камеры линкером и падения в Release -->
		<AndroidLinkMode>SdkOnly</AndroidLinkMode>

		<AndroidEnableProguard>false</AndroidEnableProguard>

		<!-- 🔥 Эти строки ОЧЕНЬ важны -->
		<!-- AndroidAarPackagingMode=raw: AAR включается как есть, но все равно извлекается для доступа к классам -->
		<AndroidAarPackagingMode>raw</AndroidAarPackagingMode>
		<AndroidUseAapt2>true</AndroidUseAapt2>
		<AndroidDexTool>d8</AndroidDexTool>
		
		<!-- 🔥 КРИТИЧЕСКИ ВАЖНО: Отключаем генерацию Java stubs полностью -->
		<!-- Это предотвращает попытки MAUI обработать любые AAR, включая Finik SDK -->
		<!-- AndroidLibrary все равно извлечет AAR и сделает его классы доступными через reflection -->
		<AndroidGenerateJavaStubs>false</AndroidGenerateJavaStubs>
		<AndroidEnableAssemblyCompression>false</AndroidEnableAssemblyCompression>
	</PropertyGroup>

	<!-- ✅ Подключение keystore.props для подписи Release -->
	<!-- Импортируем keystore.props ПЕРЕД настройками подписи -->
	<Import Project="Platforms\Android\keystore.props" Condition="Exists('$(MSBuildProjectDirectory)\Platforms\Android\keystore.props')" />

	<!-- ✅ Android Release Signing Configuration -->
	<!-- КРИТИЧЕСКИ ВАЖНО: Используем AndroidSigningKeyStore (не AndroidKeyStore) -->
	<PropertyGroup Condition="$(TargetFramework.Contains('-android')) AND '$(Configuration)' == 'Release'">
		<!-- Явно отключаем debug подпись -->
		<AndroidUseSharedRuntime>false</AndroidUseSharedRuntime>
		<EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
		
		<!-- Путь к keystore файлу (из keystore.props или по умолчанию) -->
		<AndroidSigningKeyStore Condition="'$(KeystoreFile)' != ''">$(MSBuildProjectDirectory)\Platforms\Android\$(KeystoreFile)</AndroidSigningKeyStore>
		<AndroidSigningKeyStore Condition="'$(AndroidSigningKeyStore)' == ''">$(MSBuildProjectDirectory)\Platforms\Android\yessgo-release.keystore</AndroidSigningKeyStore>
		
		<!-- Пароль keystore (из keystore.props или через параметр командной строки) -->
		<AndroidSigningStorePass Condition="'$(KeystorePassword)' != ''">$(KeystorePassword)</AndroidSigningStorePass>
		
		<!-- Alias ключа (из keystore.props или по умолчанию) -->
		<AndroidSigningKeyAlias Condition="'$(KeyAlias)' != ''">$(KeyAlias)</AndroidSigningKeyAlias>
		<AndroidSigningKeyAlias Condition="'$(AndroidSigningKeyAlias)' == ''">yessgo-key</AndroidSigningKeyAlias>
		
		<!-- Пароль ключа (из keystore.props или через параметр командной строки) -->
		<AndroidSigningKeyPass Condition="'$(KeyPassword)' != ''">$(KeyPassword)</AndroidSigningKeyPass>
		<AndroidSigningKeyPass Condition="'$(AndroidSigningKeyPass)' == '' AND '$(KeystorePassword)' != ''">$(KeystorePassword)</AndroidSigningKeyPass>
		
		<!-- Дополнительные настройки для гарантии release подписи -->
		<AndroidCreatePackagePerAbi>false</AndroidCreatePackagePerAbi>
		<AndroidEnableProguard>false</AndroidEnableProguard>
	</PropertyGroup>



	<!-- === FINIK SDK — BACKEND PROXY ПОДХОД === -->
	<!-- 
	✅ Finik SDK теперь работает через Backend Proxy
	Все вызовы Finik SDK выполняются на backend, мобильное приложение использует REST API.
	Это решает проблему с Flutter Engine, который невозможно корректно интегрировать в MAUI.
	
	Преимущества:
	- Не требует Flutter Engine в мобильном приложении
	- Централизованная логика платежей на backend
	- Безопасность (API ключи на сервере)
	- Проще обновления и поддержка
	- Кроссплатформенность (один API для Android и iOS)
	-->


	<!-- ✅ iOS -->
	<PropertyGroup Condition="$(TargetFramework.Contains('-ios'))">
		<!-- Если собираешь под симулятор -->
		<RuntimeIdentifier>iossimulator-arm64</RuntimeIdentifier>
		<!-- Если нужно под реальное устройство, укажи при сборке:
		     dotnet build -f net9.0-ios -r ios-arm64 -->
	</PropertyGroup>

	<!-- ✅ Ресурсы -->
	<ItemGroup>
		<MauiImage Include="Resources\Images\**" />
		<MauiImage Include="Resources\Eye\**" />
		<MauiImage Include="Resources\PatnerDetailViewPage\**" />
		<MauiFont Include="Resources\Fonts\**" />
		<MauiSplashScreen Include="Resources\Splash\**" Color="FFFFFF" />
		<!-- Иконка приложения - MAUI автоматически создаст все необходимые размеры для Android и iOS -->
		<MauiIcon Include="Resources\AppIcon\appicon.png" />
	</ItemGroup>

	<!-- ✅ Пакеты -->
	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
		<PackageReference Include="Mapsui" Version="4.1.9" />
		<PackageReference Include="Mapsui.Maui" Version="4.1.9" />
		<PackageReference Include="Mapsui.Tiling" Version="4.1.9" />
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.0" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.0" />
		<PackageReference Include="Microsoft.Extensions.Http" Version="9.0.0" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="9.0.0" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="9.0.100" />
		<PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="9.0.100" />
		<PackageReference Include="Microsoft.Maui.Controls.Maps" Version="9.0.100" />
		<PackageReference Include="Microsoft.Maui.Essentials" Version="9.0.100" />
		<PackageReference Include="Plugin.Fingerprint" Version="2.1.5" />
		<PackageReference Include="SkiaSharp" Version="2.88.9" />
		<PackageReference Include="SkiaSharp.Views.Maui.Controls" Version="2.88.9" />
		<PackageReference Include="Svg.Skia" Version="1.0.0.3" />
		<PackageReference Include="ZXing.Net.Maui.Controls" Version="0.6.0" />
		<!-- Xamarin.AndroidX.Emoji2.ViewsHelper удален - несовместим с .NET 9 -->
		<!-- Используем TextWatcher вместо IInputFilter для блокировки emoji -->
	</ItemGroup>

	<ItemGroup>
		<MauiXaml Update="Views\**\*.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>
	</ItemGroup>

	<!-- Исключаем тестовые файлы из компиляции основного проекта -->
	<ItemGroup>
		<AndroidResource Remove="%2a%2a\**" />
		<Compile Remove="%2a%2a\**" />
		<Compile Remove="Tests\**" />
		<EmbeddedResource Remove="%2a%2a\**" />
		<EmbeddedResource Remove="Tests\**" />
		<MauiCss Remove="%2a%2a\**" />
		<MauiXaml Remove="%2a%2a\**" />
		<None Remove="%2a%2a\**" />
		<None Remove="Tests\**" />
	</ItemGroup>
	
	<ItemGroup>
	  <Compile Update="Views\ContactsPage.xaml.cs">
	    <DependentUpon>ContactsPage.xaml</DependentUpon>
	  </Compile>
	  <Compile Update="Views\RegisterPage.xaml.cs">
	    <DependentUpon>RegisterPage.xaml</DependentUpon>
	  </Compile>
	  <Compile Update="Views\PartnerDetailViewPage.xaml.cs">
	    <DependentUpon>PartnerDetailViewPage.xaml</DependentUpon>
	  </Compile>
	</ItemGroup>
	<ItemGroup>
	  <None Update="Views\FeedbackPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </None>
	  <MauiXaml Update="Views\RegisterPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Views\PartnerDetailViewPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'net9.0-android'">
	  <PackageReference Include="Xamarin.AndroidX.Activity">
	    <Version>1.11.0</Version>
	  </PackageReference>
	  <PackageReference Include="Xamarin.AndroidX.AppCompat">
	    <Version>1.7.1.1</Version>
	  </PackageReference>
	  <PackageReference Include="Xamarin.AndroidX.Core.Core.Ktx">
	    <Version>1.17.0</Version>
	  </PackageReference>
	  <PackageReference Include="Xamarin.AndroidX.Lifecycle.Common">
	    <Version>2.9.4</Version>
	  </PackageReference>
	  <PackageReference Include="Xamarin.AndroidX.Lifecycle.Runtime">
	    <Version>2.9.4</Version>
	  </PackageReference>
	  <PackageReference Include="Xamarin.Google.Android.Material">
	    <Version>1.13.0</Version>
	  </PackageReference>
	  <PackageReference Include="Xamarin.Kotlin.StdLib">
	    <Version>2.2.21</Version>
	  </PackageReference>
	  <PackageReference Include="Xamarin.Kotlin.StdLib.Common">
	    <Version>2.0.21.5</Version>
	  </PackageReference>
	  <PackageReference Include="Xamarin.Kotlin.StdLib.Jdk7">
	    <Version>2.2.21</Version>
	  </PackageReference>
	  <PackageReference Include="Xamarin.Kotlin.StdLib.Jdk8">
	    <Version>2.2.21</Version>
	  </PackageReference>
	  <PackageReference Include="Xamarin.AndroidX.Tracing.Tracing">
	    <Version>1.3.0.1</Version>
	  </PackageReference>
	  <PackageReference Include="Xamarin.AndroidX.SavedState">
	    <Version>1.4.0</Version>
	  </PackageReference>
	</ItemGroup>
	
	<!-- ✅ DependencyOverride для принудительного использования одной версии AndroidX библиотек -->
	<!-- Исключает конфликты между -android и -ktx версиями -->
	<ItemGroup Condition="'$(TargetFramework)' == 'net9.0-android'">
	  <!-- Принудительно используем версию 1.3.0.1 для Tracing -->
	  <PackageReference Update="Xamarin.AndroidX.Tracing.Tracing" Version="1.3.0.1" />
	  <!-- Принудительно используем версию 1.4.0 для SavedState -->
	  <PackageReference Update="Xamarin.AndroidX.SavedState" Version="1.4.0" />
	</ItemGroup>
	
	<!-- ✅ УНИВЕРСАЛЬНЫЙ Target для исключения ВСЕХ дублирующихся -ktx AAR библиотек -->
	<!-- Решает проблему дублирования классов из android/ktx версий (Tracing, SavedState и др.) -->
	<!-- Исключаем все -ktx версии, оставляя только -android -->
	<Target Name="ExcludeDuplicateKtxLibraries" BeforeTargets="_ResolveLibraryProjectImports;_ExtractLibraryProjectImports" AfterTargets="_ResolveLibraryProjects" Condition="'$(TargetFramework)' == 'net9.0-android'">
		<ItemGroup>
			<!-- Исключаем все -ktx AAR, оставляя только -android версии -->
			<_ResolvedLibraryProjectImports Remove="@(_ResolvedLibraryProjectImports)" Condition="$([System.String]::Copy('%(Identity)').Contains('-ktx'))" />
			<!-- Также исключаем из списка библиотек для компиляции -->
			<_LibraryProjectImports Remove="@(_LibraryProjectImports)" Condition="$([System.String]::Copy('%(Identity)').Contains('-ktx'))" />
			<!-- Специфичные исключения для известных проблемных библиотек -->
			<_ResolvedLibraryProjectImports Remove="@(_ResolvedLibraryProjectImports)" Condition="$([System.String]::Copy('%(Identity)').Contains('tracing-ktx')) OR $([System.String]::Copy('%(Identity)').Contains('lp\174')) OR $([System.String]::Copy('%(Identity)').Contains('savedstate-ktx')) OR $([System.String]::Copy('%(Identity)').Contains('lp\178'))" />
			<_LibraryProjectImports Remove="@(_LibraryProjectImports)" Condition="$([System.String]::Copy('%(Identity)').Contains('tracing-ktx')) OR $([System.String]::Copy('%(Identity)').Contains('lp\174')) OR $([System.String]::Copy('%(Identity)').Contains('savedstate-ktx')) OR $([System.String]::Copy('%(Identity)').Contains('lp\178'))" />
		</ItemGroup>
		<Message Text="[AndroidX] Excluded duplicate -ktx libraries (tracing, savedstate, etc.)" Importance="high" />
	</Target>
	
	<!-- ✅ УНИВЕРСАЛЬНЫЙ Target для удаления конфликтующих -ktx JAR файлов -->
	<!-- Удаляет все -ktx JAR файлы перед компиляцией Java -->
	<Target Name="RemoveDuplicateKtxJars" BeforeTargets="_CompileJava" AfterTargets="_ResolveLibraryProjectImports" Condition="'$(TargetFramework)' == 'net9.0-android'">
		<ItemGroup>
			<!-- Находим все JAR файлы с -ktx в названии -->
			<KtxJarFiles Include="$(IntermediateOutputPath)lp\**\*-ktx*.jar" />
			<!-- Также удаляем по известным проблемным папкам -->
			<KtxJarFiles Include="$(IntermediateOutputPath)lp\174\**\*.jar" />
			<KtxJarFiles Include="$(IntermediateOutputPath)lp\178\**\*.jar" />
			<!-- Удаляем все JAR из папок, содержащих -ktx в пути -->
			<KtxJarFiles Include="$(IntermediateOutputPath)lp\**\jl\classes.jar" Condition="$([System.String]::Copy('%(RootDir)%(Directory)').Contains('ktx'))" />
		</ItemGroup>
		<Delete Files="@(KtxJarFiles)" ContinueOnError="true" />
		<Message Text="[AndroidX] Removed @(KtxJarFiles-&gt;Count()) duplicate -ktx JAR files" Importance="normal" Condition="'@(KtxJarFiles)' != ''" />
	</Target>

</Project>