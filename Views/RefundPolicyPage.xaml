<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:YessGoFront.Views.Controls"
             x:Class="YessGoFront.Views.RefundPolicyPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F4F6F8">
    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Верхняя панель -->
        <Grid Padding="16,44,16,8" BackgroundColor="#0F6B53">
            <Grid ColumnDefinitions="Auto,*,Auto" VerticalOptions="Center">
                <Border WidthRequest="36" HeightRequest="36"
                    StrokeThickness="0"
                    BackgroundColor="#FFFFFF"
                    StrokeShape="RoundRectangle8">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped" />
                    </Border.GestureRecognizers>
                    <Image Source="back_arrow_icon.png" 
                        Aspect="AspectFit" 
                        Margin="8" />
                </Border>

                <Label Grid.Column="1"
                    Text="Политика возврата"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    TextColor="White"
                    FontAttributes="Bold"
                    FontSize="18"/>
            </Grid>
        </Grid>
        
        <!-- Контент -->
        <ScrollView Grid.Row="1" Padding="16">
            <Label FontSize="14" TextColor="#6B7280" LineBreakMode="WordWrap">
                <Label.FormattedText>
                    <FormattedString>

                        <!-- Заголовок -->
                        <Span Text="ПОЛИТИКА ВОЗВРАТА И ОТМЕНЫ" FontAttributes="Bold" FontSize="20"/>
                        <Span Text="&#10;Приложения YESS!GO" FontSize="16"/>
                        <Span Text="&#10;&#10;" />

                        <!-- 1. Общие положения -->
                        <Span Text="1. ОБЩИЕ ПОЛОЖЕНИЯ" FontAttributes="Bold"/>
                        <Span Text="&#10;--------------------------------------&#10;" />

                        <Span Text="1.1. Настоящая Политика возврата и отмены (далее — «Политика») определяет порядок возврата средств и отмены заказов при использовании приложения YESS!GO." />
                        <Span Text="&#10;&#10;" />

                        <Span Text="1.2. Возврат средств осуществляется в соответствии с законодательством Кыргызской Республики о защите прав потребителей." />
                        <Span Text="&#10;&#10;" />

                        <!-- 2. Возврат средств -->
                        <Span Text="2. ВОЗВРАТ СРЕДСТВ ЗА ТОВАРЫ И УСЛУГИ" FontAttributes="Bold"/>
                        <Span Text="&#10;--------------------------------------&#10;" />

                        <Span Text="2.1. Возврат средств осуществляется в соответствии с условиями конкретного партнёра." />
                        <Span Text="&#10;&#10;" />

                        <Span Text="2.2. Для возврата средств необходимо:" />
                        <Span Text="&#10;• Обратиться в службу поддержки Приложения" />
                        <Span Text="&#10;• Предоставить информацию о заказе (номер, дата, сумма)" />
                        <Span Text="&#10;• Указать причину возврата" />
                        <Span Text="&#10;&#10;" />

                        <Span Text="2.3. Срок рассмотрения заявления о возврате: до 10 рабочих дней." />
                        <Span Text="&#10;&#10;" />

                        <Span Text="2.4. Возврат осуществляется на тот же способ оплаты, который был использован при покупке." />
                        <Span Text="&#10;&#10;" />

                        <Span Text="2.5. Срок возврата средств на банковскую карту: до 14 рабочих дней с момента одобрения." />
                        <Span Text="&#10;&#10;" />

                        <!-- 3. Отмена заказа -->
                        <Span Text="3. ОТМЕНА ЗАКАЗА" FontAttributes="Bold"/>
                        <Span Text="&#10;--------------------------------------&#10;" />

                        <Span Text="3.1. Пользователь может отменить заказ до момента его подтверждения партнёром." />
                        <Span Text="&#10;&#10;" />

                        <Span Text="3.2. После подтверждения заказа отмена возможна только по согласованию с партнёром." />
                        <Span Text="&#10;&#10;" />

                        <Span Text="3.3. При отмене заказа до подтверждения средства возвращаются в полном объёме." />
                        <Span Text="&#10;&#10;" />

                        <Span Text="3.4. После подтверждения возврат средств осуществляется по правилам партнёра." />
                        <Span Text="&#10;&#10;" />

                        <!-- 5. Невозвратные товары -->
                        <Span Text="4. НЕВОЗВРАТНЫЕ ТОВАРЫ И УСЛУГИ" FontAttributes="Bold"/>
                        <Span Text="&#10;--------------------------------------&#10;" />

                        <Span Text="4.1. Возврат не осуществляется для:" />
                        <Span Text="&#10;• Цифровых товаров, предоставление которых уже началось" />
                        <Span Text="&#10;• Индивидуально изготовленных товаров" />
                        <Span Text="&#10;• Товаров с истёкшим сроком годности или повреждённых по вине Пользователя" />
                        <Span Text="&#10;• Услуг, которые были полностью оказаны" />
                        <Span Text="&#10;&#10;" />

                        <!-- 6. Спорные ситуации -->
                        <Span Text="5. СПОРНЫЕ СИТУАЦИИ" FontAttributes="Bold"/>
                        <Span Text="&#10;--------------------------------------&#10;" />

                        <Span Text="5.1. В случае споров Приложение выступает посредником между Пользователем и партнёром." />
                        <Span Text="&#10;&#10;" />

                        <Span Text="5.2. Приложение может принять решение о возврате средств на основании представленных доказательств." />
                        <Span Text="&#10;&#10;" />

                        <!-- 7. Контакты -->
                        <Span Text="6. КОНТАКТНАЯ ИНФОРМАЦИЯ" FontAttributes="Bold"/>
                        <Span Text="&#10;--------------------------------------&#10;" />

                        <Span Text="📧 Email: support@yessgo.kg" />
                        <Span Text="&#10;📞 Телефон: +996 (990) 500 757" />
                        <Span Text="&#10;⏰ Время работы: Понедельник – Пятница: 9:00 – 18:00" />

                    </FormattedString>
                </Label.FormattedText>
            </Label>
        </ScrollView>


        <!-- Нижний навбар -->
        <controls:BottomNavBar x:Name="BottomBar" Grid.Row="2" />
    </Grid>
</ContentPage>

