<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:YessGoFront.Views.Controls"
             x:Class="YessGoFront.Views.PaymentSecurityPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F4F6F8">
    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Верхняя панель -->
        <Grid Padding="16,44,16,8" BackgroundColor="#0F6B53">
            <Grid ColumnDefinitions="Auto,*,Auto" VerticalOptions="Center">
                <Border WidthRequest="36" HeightRequest="36"
                        StrokeThickness="0"
                        BackgroundColor="#FFFFFF"
                        StrokeShape="RoundRectangle 18">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped" />
                    </Border.GestureRecognizers>
                    <Image Source="back_partner.svg" 
                        Aspect="AspectFit" 
                        Margin="8" />
                </Border>

                <Label Grid.Column="1"
                    Text="Безопасность платежей"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    TextColor="White"
                    FontAttributes="Bold"
                    FontSize="18"/>
            </Grid>
        </Grid>
        
        <!-- Контент -->
        <ScrollView Grid.Row="1" Padding="16">
            <Label FontSize="14" TextColor="#6B7280" LineBreakMode="WordWrap">
                <Label.FormattedText>
                    <FormattedString>

                        <!-- Заголовок -->
                        <Span Text="БЕЗОПАСНОСТЬ ПЛАТЕЖЕЙ" FontAttributes="Bold" FontSize="20"/>
                        <Span Text="&#10;Приложения YESS!GO" FontSize="16"/>
                        <Span Text="&#10;&#10;" />

                        <!-- 1. Общие положения -->
                        <Span Text="1. ОБЩИЕ ПОЛОЖЕНИЯ" FontAttributes="Bold"/>
                        <Span Text="&#10;--------------------------------------&#10;" />

                        <Span Text="1.1. Безопасность платежей является приоритетом для YESS!GO. Мы применяем современные технологии для защиты персональных данных и финансовой информации." />
                        <Span Text="&#10;&#10;" />

                        <Span Text="1.2. Все платежи обрабатываются через защищённые платёжные системы, соответствующие международным стандартам безопасности." />
                        <Span Text="&#10;&#10;" />

                        <!-- 2. Защита персональных данных -->
                        <Span Text="2. ЗАЩИТА ПЕРСОНАЛЬНЫХ ДАННЫХ" FontAttributes="Bold"/>
                        <Span Text="&#10;--------------------------------------&#10;" />

                        <Span Text="2.1. При обработке платежей мы не храним полные данные банковских карт на наших серверах." />
                        <Span Text="&#10;&#10;" />

                        <Span Text="2.2. Все данные передаются по защищённому соединению (HTTPS) с использованием шифрования." />
                        <Span Text="&#10;&#10;" />

                        <Span Text="2.3. Доступ к персональным данным имеют только уполномоченные сотрудники, прошедшие проверку безопасности." />
                        <Span Text="&#10;&#10;" />

                        <!-- 3. Методы оплаты -->
                        <Span Text="3. МЕТОДЫ ОПЛАТЫ" FontAttributes="Bold"/>
                        <Span Text="&#10;--------------------------------------&#10;" />

                        <Span Text="3.1. В Приложении доступны следующие способы оплаты:" />
                        <Span Text="&#10;• Банковские карты (Visa, MasterCard)" />
                        <Span Text="&#10;• Электронные кошельки" />
                        <Span Text="&#10;• Мобильные платежи" />
                        <Span Text="&#10;&#10;" />

                        <Span Text="3.2. Обработка платежей осуществляется через сертифицированных платёжных провайдеров." />
                        <Span Text="&#10;&#10;" />

                        <!-- 4. Безопасность при оплате картой -->
                        <Span Text="4. БЕЗОПАСНОСТЬ ПРИ ОПЛАТЕ КАРТОЙ" FontAttributes="Bold"/>
                        <Span Text="&#10;--------------------------------------&#10;" />

                        <Span Text="4.1. При оплате картой данные передаются напрямую в платёжную систему, минуя серверы Приложения." />
                        <Span Text="&#10;&#10;" />

                        <Span Text="4.2. Для безопасного хранения применяется технология токенизации." />
                        <Span Text="&#10;&#10;" />

                        <Span Text="4.3. Может использоваться двухфакторная аутентификация, если это требуется банком пользователя." />
                        <Span Text="&#10;&#10;" />

                        <!-- 5. Мониторинг и защита -->
                        <Span Text="5. МОНИТОРИНГ И ЗАЩИТА" FontAttributes="Bold"/>
                        <Span Text="&#10;--------------------------------------&#10;" />

                        <Span Text="5.1. Платёжные транзакции мониторятся автоматически для выявления подозрительных действий." />
                        <Span Text="&#10;&#10;" />

                        <Span Text="5.2. В случае подозрительной активности транзакция может быть временно заблокирована." />
                        <Span Text="&#10;&#10;" />

                        <Span Text="5.3. Пользователь будет уведомлён о любых подозрительных операциях, связанных с его учётной записью." />
                        <Span Text="&#10;&#10;" />

                        <!-- 6. Рекомендации -->
                        <Span Text="6. РЕКОМЕНДАЦИИ ПО БЕЗОПАСНОСТИ" FontAttributes="Bold"/>
                        <Span Text="&#10;--------------------------------------&#10;" />

                        <Span Text="6.1. Не передавайте данные для входа третьим лицам." />
                        <Span Text="&#10;&#10;" />

                        <Span Text="6.2. Используйте сложный пароль и регулярно обновляйте его." />
                        <Span Text="&#10;&#10;" />

                        <Span Text="6.3. Избегайте использования Приложения на устройствах с подозрительным ПО." />
                        <Span Text="&#10;&#10;" />

                        <Span Text="6.4. Немедленно сообщайте в поддержку о подозрительных транзакциях." />
                        <Span Text="&#10;&#10;" />

                        <!-- 7. Ответственность -->
                        <Span Text="7. ОТВЕТСТВЕННОСТЬ" FontAttributes="Bold"/>
                        <Span Text="&#10;--------------------------------------&#10;" />

                        <Span Text="7.1. YESS!GO не несёт ответственности за ущерб, возникший из-за несанкционированного доступа, произошедшего по вине пользователя." />
                        <Span Text="&#10;&#10;" />

                        <Span Text="7.2. В случае подозрительных транзакций Пользователь должен сообщить в службу поддержки и в свой банк." />
                        <Span Text="&#10;&#10;" />

                        <!-- 8. Контакты -->
                        <Span Text="8. КОНТАКТНАЯ ИНФОРМАЦИЯ" FontAttributes="Bold"/>
                        <Span Text="&#10;--------------------------------------&#10;" />

                        <Span Text="📧 Email: support@yessgo.kg" />
                        <Span Text="&#10;📞 Телефон: +996 (990) 500 757" />
                        <Span Text="&#10;⏰ Время работы: Понедельник – Пятница: 9:00 – 18:00" />

                    </FormattedString>
                </Label.FormattedText>
            </Label>
        </ScrollView>


        <!-- Нижний навбар -->
        <controls:BottomNavBar x:Name="BottomBar" Grid.Row="2" />
    </Grid>
</ContentPage>

